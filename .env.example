# Real values do NOT live in this repo. Put them in one shared file:
#
#   ~/.config/mt2mods/env     chmod 600
#
# Every MT2 mod repo publishes under the same SpecialCircumstances team and
# restores from the same private feed, so one file serves all of them. Each
# repo's .env is only a shim that sources it, which keeps the documented
# build step working unchanged:
#
#   set -a; . ./.env; set +a
#
# GITHUB_USER / GH_AUTH_TOKEN  authenticate the private GitHub Packages feed
#   serving TrainworksReloaded.Base and Conductor. Without them, restore
#   fails with 401 Unauthorized / NU1301.
# TCLI_AUTH_TOKEN  a Thunderstore service-account token, for `tcli publish`.
#   CI does not use this file -- it reads the TCLI_AUTH_TOKEN repo secret.

GITHUB_USER=your-github-username
GH_AUTH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
TCLI_AUTH_TOKEN=tss_xxxxxxxxxxxxxxxxxxxx
